{
  "manifest_version": 3,
  "name": "Pulse Hesias",
  "version": "1.0.1",
  "update_url": "http://localhost:3000/updates.xml",
  "description": "Environnement d'examen s\u00e9curis\u00e9 pour la plateforme Hesias",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "activeTab",
    "management",
    "system.display",
    "system.cpu",
    "system.memory",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hesias.fr/*",
        "https://*.hesias.net/*"
      ],
      "js": [
        "vmdetect.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hesias_rules",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pulse Hesias"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
